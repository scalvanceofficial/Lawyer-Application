rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /profile_pictures/{userId}.jpg {
      allow read: if signedIn();
      allow write: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /case_documents/{caseId}/{fileName} {
      allow read: if signedIn()
        && (
          firestore.get(/databases/(default)/documents/cases/$(caseId)).data.clientId
            == request.auth.uid
          || firestore.exists(
            /databases/(default)/documents/consultationRequests/$(caseId + '_' + request.auth.uid)
          )
        );
      allow create: if signedIn()
        && firestore.get(/databases/(default)/documents/cases/$(caseId)).data.clientId
          == request.auth.uid
        && request.resource.size < 10 * 1024 * 1024;
      allow update, delete: if signedIn()
        && firestore.get(/databases/(default)/documents/cases/$(caseId)).data.clientId
          == request.auth.uid;
    }

    match /support_attachments/{userId}/{ticketId}/{fileName} {
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || request.auth.token.admin == true
        );
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches(
          '(image/.*|application/pdf|application/msword|application/vnd.openxmlformats-officedocument.wordprocessingml.document)'
        );
      allow update, delete: if false;
    }
  }
}
