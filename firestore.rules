rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/accountDeletionJobs/$(request.auth.uid));
    }

    match /accountDeletionJobs/{userId} {
      // The user can watch completion even after ordinary account access stops.
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    function supportAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function ownsCase(caseId) {
      return signedIn()
        && get(/databases/$(database)/documents/cases/$(caseId)).data.clientId
          == request.auth.uid;
    }

    function requestId(caseId, lawyerId) {
      return caseId + '_' + lawyerId;
    }

    function isAssigned(caseId) {
      return signedIn()
        && exists(/databases/$(database)/documents/consultationRequests/$(requestId(caseId, request.auth.uid)));
    }

    function acceptedRequest(id) {
      return signedIn()
        && !exists(/databases/$(database)/documents/accountDeletionJobs/$(get(/databases/$(database)/documents/consultationRequests/$(id)).data.clientId))
        && !exists(/databases/$(database)/documents/accountDeletionJobs/$(get(/databases/$(database)/documents/consultationRequests/$(id)).data.lawyerId))
        && get(/databases/$(database)/documents/consultationRequests/$(id)).data.status
          == 'accepted'
        && request.auth.uid in [
          get(/databases/$(database)/documents/consultationRequests/$(id)).data.clientId,
          get(/databases/$(database)/documents/consultationRequests/$(id)).data.lawyerId
        ]
        && get(/databases/$(database)/documents/cases/$(
          get(/databases/$(database)/documents/consultationRequests/$(id)).data.caseId
        )).data.paymentStatus == 'paid'
        && get(/databases/$(database)/documents/cases/$(
          get(/databases/$(database)/documents/consultationRequests/$(id)).data.caseId
        )).data.isActive == true;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'client'
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.dob is string
        && request.resource.data.gender is string
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.img is string
        && request.resource.data.img.size() > 0
        && request.resource.data.term == true
        && request.resource.data.token is string;
      allow read: if signedIn() && request.auth.uid == userId;
      allow update, delete: if signedIn() && request.auth.uid == userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.phone == resource.data.phone;
    }

    match /lawyers/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'lawyer'
        && request.resource.data.term == true
        && request.resource.data.verified == false
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.img is string
        && request.resource.data.img.size() > 0
        && request.resource.data.barid is string
        && request.resource.data.aoe is list
        && request.resource.data.aoe.size() > 0
        && request.resource.data.expertise is list
        && request.resource.data.availability is list
        && request.resource.data.availability.size() > 0
        && request.resource.data.fee is number
        && request.resource.data.fee >= 0;
      allow read: if signedIn();
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.phone == resource.data.phone
        // Verification, trial start and ratings are set only by admins/servers.
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'verified', 'date', 'createdAt', 'uid', 'role',
          'rating', 'ratingSum', 'reviewCount', 'ratingUpdatedAt'
        ]);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /areaofexpertise/{documentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /cases/{caseId} {
      allow create: if signedIn()
        && request.resource.data.caseId == caseId
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.status == 'draft'
        && request.resource.data.isActive == false
        && request.resource.data.documents is list
        && request.resource.data.documentPaths is list;
      allow read: if signedIn()
        && (resource.data.clientId == request.auth.uid || isAssigned(caseId));
      allow update: if signedIn()
        && resource.data.clientId == request.auth.uid
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.caseId == resource.data.caseId
        // Only verifyCasePayment (server) may mark a case paid/active.
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'paymentStatus', 'isActive', 'casePaymentId', 'activatedAt'
        ]);
      allow delete: if signedIn()
        && resource.data.clientId == request.auth.uid
        && resource.data.isActive == false;
    }

    match /casePayments/{paymentId} {
      // Created only by verifyCasePayment after Razorpay confirms the payment.
      allow create: if false;
      allow read: if signedIn()
        && resource.data.clientId == request.auth.uid;
      allow update, delete: if false;
    }

    match /consultationRequests/{id} {
      allow create: if signedIn()
        && request.resource.data.requestId == id
        && request.resource.data.clientId == request.auth.uid
        && id == requestId(
          request.resource.data.caseId,
          request.resource.data.lawyerId
        )
        && get(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.clientId
          == request.auth.uid
        && get(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.status
          != 'completed'
        && exists(/databases/$(database)/documents/lawyers/$(request.resource.data.lawyerId))
        && !exists(/databases/$(database)/documents/accountDeletionJobs/$(request.resource.data.lawyerId))
        && request.resource.data.status == 'pending';
      allow read: if signedIn()
        && request.auth.uid in [resource.data.clientId, resource.data.lawyerId];
      allow update: if signedIn()
        && (
          (
            request.auth.uid == resource.data.lawyerId
            && resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'rejected']
          )
          ||
          (
            request.auth.uid == resource.data.clientId
            && resource.data.status == 'accepted'
            && request.resource.data.status == 'completed'
            && get(/databases/$(database)/documents/cases/$(resource.data.caseId)).data.paymentStatus
              == 'paid'
            && get(/databases/$(database)/documents/cases/$(resource.data.caseId)).data.isActive
              == true
          )
        )
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'respondedAt', 'completedAt']);
      allow delete: if false;
    }

    match /lawyerReviews/{reviewId} {
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/accountDeletionJobs/$(request.resource.data.lawyerId))
        && request.resource.data.reviewId == reviewId
        && request.resource.data.requestId == reviewId
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.review is string
        && request.resource.data.review.size() >= 3
        && request.resource.data.review.size() <= 1000
        && get(/databases/$(database)/documents/consultationRequests/$(reviewId)).data.clientId
          == request.auth.uid
        && get(/databases/$(database)/documents/consultationRequests/$(reviewId)).data.caseId
          == request.resource.data.caseId
        && get(/databases/$(database)/documents/consultationRequests/$(reviewId)).data.lawyerId
          == request.resource.data.lawyerId
        && get(/databases/$(database)/documents/consultationRequests/$(reviewId)).data.status
          == 'accepted'
        && get(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.clientId
          == request.auth.uid
        && get(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.paymentStatus
          == 'paid'
        && get(/databases/$(database)/documents/cases/$(request.resource.data.caseId)).data.isActive
          == true;
      allow read: if signedIn();
      allow update, delete: if false;
    }

    match /caseDocuments/{documentId} {
      allow create: if signedIn()
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.clientId == request.auth.uid
        && ownsCase(request.resource.data.caseId);
      allow read: if signedIn()
        && (resource.data.clientId == request.auth.uid
          || isAssigned(resource.data.caseId));
      allow update, delete: if false;
    }

    match /caseTimeline/{eventId} {
      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && (
          request.resource.data.clientId == request.auth.uid
          || isAssigned(request.resource.data.caseId)
        );
      allow read: if signedIn()
        && (resource.data.clientId == request.auth.uid
          || isAssigned(resource.data.caseId));
      allow update, delete: if false;
    }

    match /caseChats/{chatId} {
      allow read: if acceptedRequest(chatId);
      allow create, update: if acceptedRequest(chatId)
        && request.resource.data.requestId == chatId
        && request.auth.uid in [
          request.resource.data.clientId,
          request.resource.data.lawyerId
        ];
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if acceptedRequest(chatId);
        allow create: if acceptedRequest(chatId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId
            == (
              request.auth.uid
                == get(/databases/$(database)/documents/consultationRequests/$(chatId)).data.clientId
              ? get(/databases/$(database)/documents/consultationRequests/$(chatId)).data.lawyerId
              : get(/databases/$(database)/documents/consultationRequests/$(chatId)).data.clientId
            )
          && request.resource.data.message is string
          && request.resource.data.message.size() > 0
          && request.resource.data.isRead == false;
        allow update: if acceptedRequest(chatId)
          && request.auth.uid == resource.data.receiverId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead'])
          && request.resource.data.isRead == true;
        allow delete: if false;
      }
    }

    match /notifications/{notificationId} {
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && !exists(/databases/$(database)/documents/accountDeletionJobs/$(request.resource.data.recipientId));
      allow read: if signedIn()
        && resource.data.recipientId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isRead']);
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userType in ['lawyer', 'client']
        && request.resource.data.status in ['success', 'failed']
        && request.resource.data.amount is number
        && request.resource.data.currency == 'INR'
        && request.resource.data.platform is string;
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /plans/{planId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /subscriptions/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      // Only verified Firebase Functions may grant or extend paid access.
      allow write: if false;
    }

    match /appleSubscriptions/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /applePurchaseAccounts/{document=**} {
      allow read, write: if false;
    }
    match /applePurchaseTokens/{document=**} {
      allow read, write: if false;
    }
    match /verifiedSubscriptionPayments/{document=**} {
      allow read, write: if false;
    }

    match /usefulkey/{keyId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /saved_lawyers/{clientUid}/lawyers/{lawyerUid} {
      allow read, delete: if signedIn() && request.auth.uid == clientUid;
      allow create, update: if signedIn()
        && request.auth.uid == clientUid
        && request.resource.data.keys().hasOnly(['lawyerId', 'savedAt'])
        && !exists(/databases/$(database)/documents/accountDeletionJobs/$(lawyerUid))
        && request.resource.data.lawyerId == lawyerUid
        && request.resource.data.savedAt == request.time;
    }

    match /help_articles/{articleId} {
      allow read: if signedIn() && resource.data.isActive == true;
      allow write: if supportAdmin();
    }

    match /faqs/{faqId} {
      allow read: if signedIn() && resource.data.isActive == true;
      allow write: if supportAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn() && resource.data.isActive == true;
      allow write: if supportAdmin();
    }

    match /system_status/{statusId} {
      allow read: if signedIn();
      allow write: if supportAdmin();
    }

    match /support_tickets/{ticketId} {
      allow create: if signedIn()
        && request.resource.data.ticketId == ticketId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.priority in ['low', 'medium', 'high', 'urgent']
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 4
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10
        && request.resource.data.attachments is list;
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || supportAdmin());
      allow update: if supportAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.ticketId == resource.data.ticketId
          && (
            (
              resource.data.status == 'open'
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['title', 'description', 'category', 'priority', 'updatedAt'])
            )
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'updatedAt', 'closedAt'])
              && request.resource.data.status in ['open', 'closed']
            )
          )
        );
      allow delete: if false;
    }

    match /support_ticket_messages/{messageId} {
      allow read: if signedIn()
        && (
          get(/databases/$(database)/documents/support_tickets/$(resource.data.ticketId)).data.userId
            == request.auth.uid
          || supportAdmin()
        );
      allow create: if signedIn()
        && request.resource.data.messageId == messageId
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && (
          get(/databases/$(database)/documents/support_tickets/$(request.resource.data.ticketId)).data.userId
            == request.auth.uid
          || supportAdmin()
        );
      allow update: if supportAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isSeen']));
      allow delete: if false;
    }

    match /bug_reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 10;
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || supportAdmin());
      allow update: if supportAdmin();
      allow delete: if false;
    }

    match /feature_requests/{featureId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.votes == [request.auth.uid];
      allow update: if supportAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && request.auth.uid in request.resource.data.votes);
      allow delete: if false;
    }

    match /feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow read: if supportAdmin();
      allow update, delete: if false;
    }
  }
}
